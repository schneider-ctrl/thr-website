<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} – {{ site.title }}{% else %}{{ site.seo_title or site.title }}{% endif %}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <meta name="theme-color" content="#FFFDEB">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{% if title %}{{ title }} – {{ site.title }}{% else %}{{ site.seo_title or site.title }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="de_DE">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if title %}{{ title }} – {{ site.title }}{% else %}{{ site.seo_title or site.title }}{% endif %}">
  <meta name="twitter:description" content="{{ description or site.description }}">
  <meta name="twitter:image" content="{{ site.url }}/assets/og-image.jpg">
  {% if page.url == '/' %}<link rel="preload" as="image" href="{{ home.hero.image }}">{% endif %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "{{ site.title }}",
    "url": "{{ site.url }}/",
    "telephone": "+49{{ site.phone | replace(' ', '') | replace('0', '', 1) }}",
    "email": "{{ site.email }}",
    "image": "{{ site.url }}/assets/og-image.jpg",
    "logo": "{{ site.url }}{{ site.logo }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address_line1 }}",
      "postalCode": "{{ site.address_line2 | truncate(5, true, '') }}",
      "addressLocality": "Rostock",
      "addressCountry": "DE"
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday"], "opens": "08:00", "closes": "15:30" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "08:00", "closes": "13:00" }
    ],
    "areaServed": [{% for area in home.besuch.areas %}{{ area | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]{% if site.facebook != 'https://www.facebook.com/' or site.instagram != 'https://www.instagram.com/' %},
    "sameAs": [{% if site.facebook != 'https://www.facebook.com/' %}{{ site.facebook | dump | safe }}{% endif %}{% if site.facebook != 'https://www.facebook.com/' and site.instagram != 'https://www.instagram.com/' %}, {% endif %}{% if site.instagram != 'https://www.instagram.com/' %}{{ site.instagram | dump | safe }}{% endif %}]{% endif %}
  }
  </script>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/poppins-latin-800-normal.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/poppins-latin-500-normal.woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <script>
    // Ladebildschirm nur einmal pro Sitzung zeigen
    if (sessionStorage.getItem("thr-loaded")) document.documentElement.classList.add("no-preloader");
  </script>
  <div class="preloader" id="preloader" aria-hidden="true">
    <div class="preloader__stage">
      <!-- Phase 1: drei Linien laufen durch -->
      <div class="preloader__sweep" role="presentation">
        <span></span><span></span><span></span>
      </div>
      <!-- Phase 2: Logo baut sich Zeile für Zeile auf -->
      <div class="preloader__brand" role="presentation">
        <div class="preloader__row"><span class="preloader__word">Treppenhaus</span><span class="preloader__line"></span></div>
        <div class="preloader__row"><span class="preloader__word">Reinigung</span><span class="preloader__line"></span></div>
        <div class="preloader__row"><span class="preloader__word">Rostock</span><span class="preloader__line"></span></div>
      </div>
    </div>
  </div>

  <header class="header">
    <div class="container header__inner">
      <a href="/#start" class="header__logo">
        <img src="{{ site.logo }}" alt="{{ site.title }}">
      </a>
      <button class="nav-toggle" aria-label="Menü öffnen" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <nav class="nav">
        {% for item in site.nav %}
          <a href="/{{ item.anchor }}" class="nav__link{% if loop.first %} nav__link--active{% endif %}">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container footer__grid">
      <div class="footer__logo">
        <img src="{{ site.logo }}" alt="{{ site.title }}">
      </div>
      <div class="footer__contact">
        <a class="u-underline" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>
        <a href="mailto:{{ site.email }}" class="u-underline">{{ site.email }}</a>
        <p>{{ site.address_line1 }}<br>{{ site.address_line2 }}</p>
      </div>
      <div class="footer__meta">
        <nav class="footer__legal">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
        <div class="footer__social">
          <a href="{{ site.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.3-1.5 1.6-1.5h1.6V3.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.3H7.6V13h2.7v8h3.2z"/></svg>
          </a>
          <a href="{{ site.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div class="container footer__copyright">{{ site.copyright }}</div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
