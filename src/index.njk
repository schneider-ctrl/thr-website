---
layout: base.njk
permalink: /
---

<!-- HERO -->
<section class="hero" id="start" style="background-image: url('{{ home.hero.image }}');">
  <span class="sr-only">{{ home.hero.image_alt }}</span>
  <div class="container">
    <div class="hero__panel">
      <div class="hero__green">
        <h1>{{ home.hero.heading | nl2br | safe }}</h1>
      </div>
      <div class="hero__white">
        <p class="h4">{{ home.hero.box_text | nl2br | safe }}</p>
        <a href="{{ home.hero.cta_anchor }}" class="btn btn--yellow">{{ home.hero.cta_label }}</a>
      </div>
    </div>
  </div>
</section>

<!-- INTRO -->
<section class="section intro" id="ueber-uns">
  <div class="container intro__grid">
    <div class="intro__image">
      {% img home.intro.image, home.intro.image_alt, "(max-width: 900px) 100vw, 576px" %}
    </div>
    <div class="intro__content">
      <p class="lead lead--bold">{{ home.intro.text }}</p>
      <a href="{{ home.intro.cta_anchor }}" class="btn btn--outline">{{ home.intro.cta_label }}</a>
    </div>
  </div>
</section>

<!-- LÖSUNGEN -->
<section class="section loesungen">
  <div class="container">
    <h2 class="h1">{{ home.loesungen.heading | nl2br | safe }}</h2>
    <p class="lead loesungen__text">{{ home.loesungen.text }}</p>
    <div class="stats">
      {% for stat in home.loesungen.stats %}
        <span class="mono-label">{{ stat.label }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<!-- KOMPETENZEN -->
<section class="section kompetenzen" id="kompetenzen">
  <div class="container kompetenzen__grid">
    <div class="card card--green">
      <h2 class="h3">{{ home.kompetenzen.heading | nl2br | safe }}</h2>
      <ul class="checklist">
        {% for item in home.kompetenzen.items %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <div class="card__actions">
        <a href="{{ home.kompetenzen.cta1_anchor }}" class="btn btn--outline-light">{{ home.kompetenzen.cta1_label }}</a>
        <a href="{{ home.kompetenzen.cta2_anchor }}" class="btn btn--yellow">{{ home.kompetenzen.cta2_label }}</a>
      </div>
    </div>
    <div class="card card--image">
      {% img home.kompetenzen.card_image, home.kompetenzen.card_image_alt, "(max-width: 900px) 100vw, 588px" %}
      <div class="card__body">
        <h3 class="h4">{{ home.kompetenzen.card_heading | nl2br | safe }}</h3>
        <p>{{ home.kompetenzen.card_text }}</p>
      </div>
    </div>
  </div>

  <div class="container kompetenzen__grid kompetenzen__grid--cards">
    {% for card in home.cards.items %}
      <div class="card card--image">
        {% img card.image, card.image_alt, "(max-width: 900px) 100vw, 588px" %}
        <div class="card__body">
          <h3 class="h5 u-upper">{{ card.heading | nl2br | safe }}</h3>
          <p>{{ card.text }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<!-- JOBS -->
<section class="section jobs" id="jobs">
  <div class="container">
    <h2 class="h1">{{ home.jobs.heading | nl2br | safe }}</h2>
    <div class="jobs__grid">
      <div class="jobs__team">
        <h3 class="h3">{{ home.jobs.team_heading }}</h3>
        <p class="lead--bold">{{ home.jobs.team_text }}</p>
      </div>
      <div class="card card--yellow">
        <span class="mono-label">{{ home.jobs.box_eyebrow }}</span>
        <h3 class="h4 u-upper">{{ home.jobs.box_heading }}</h3>
        <p>{{ home.jobs.box_text }}</p>
        <a href="{{ home.jobs.box_cta_anchor }}" class="btn btn--outline">{{ home.jobs.box_cta_label }}</a>
      </div>
    </div>
  </div>
  <div class="jobs__slider" data-slider aria-roledescription="Karussell" aria-label="Bilder aus dem Team">
    <button type="button" class="slider__btn slider__btn--prev" aria-label="Vorheriges Bild">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <div class="slider__track">
      {% for item in home.jobs.gallery %}
        {% img item.image, item.alt, "(max-width: 900px) 80vw, 465px", "data-slide" %}
      {% endfor %}
    </div>
    <button type="button" class="slider__btn slider__btn--next" aria-label="Nächstes Bild">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>
    </button>
  </div>
</section>

<!-- KONTAKT -->
<section class="section kontakt" id="kontakt">
  <div class="container kontakt__grid">
    <div class="kontakt__form-col">
      <div class="kontakt__quick">
        <div>
          <span class="mono-label">Telefonnummer</span>
          <a class="mono-value u-underline" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a>
        </div>
        <div>
          <span class="mono-label">E-Mail Adresse</span>
          <a class="mono-value u-underline" href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
      </div>
      <div class="card card--form">
        <span class="mono-label">{{ home.kontakt.form_eyebrow }}</span>
        <h3 class="h4 u-upper">{{ home.kontakt.form_heading | nl2br | safe }}</h3>
        <form name="kontakt" method="POST" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="kontakt">
          <p class="sr-only"><label>Nicht ausfüllen: <input name="bot-field"></label></p>
          <label id="thema-label" for="thema-toggle">Thema</label>
          <div class="dropdown" data-dropdown>
            <button type="button" id="thema-toggle" class="dropdown__toggle" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="thema-label thema-toggle">
              <span data-dropdown-value>{{ home.kontakt.topics[0] }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <ul class="dropdown__list" role="listbox" aria-labelledby="thema-label" hidden>
              {% for topic in home.kontakt.topics %}
                <li role="option" tabindex="-1" data-value="{{ topic }}"{% if loop.first %} aria-selected="true"{% endif %}>{{ topic }}</li>
              {% endfor %}
            </ul>
            <input type="hidden" name="thema" value="{{ home.kontakt.topics[0] }}">
          </div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required>
          <label for="email">E-Mail</label>
          <input type="email" id="email" name="email" required>
          <label for="nachricht">Nachricht</label>
          <textarea id="nachricht" name="nachricht" rows="6" required></textarea>
          <label class="checkbox">
            <input type="checkbox" name="datenschutz" required>
            <span>{{ home.kontakt.privacy_text | replace("Datenschutzerklärung", '<a href="/datenschutz/">Datenschutzerklärung</a>') | safe }}</span>
          </label>
          <button type="submit" class="btn btn--outline">{{ home.kontakt.submit_label }}</button>
        </form>
      </div>
    </div>
    <div class="kontakt__text">
      <h2 class="h2">{{ home.kontakt.heading | nl2br | safe }}</h2>
      <p>{{ home.kontakt.text }}</p>
    </div>
  </div>
</section>

<!-- BESUCH / STANDORT -->
<section class="section besuch">
  <div class="container">
    <h2 class="h1">{{ home.besuch.heading | nl2br | safe }}</h2>
    <p class="lead--bold besuch__intro">{{ home.besuch.text }}</p>

    <div class="besuch__box">
      <div class="besuch__box-head">
        <h3 class="h3">{{ home.besuch.box_heading | nl2br | safe }}</h3>
        <p>{{ home.besuch.box_text }}</p>
      </div>
      <div class="besuch__box-grid">
        <div class="besuch__info">
          <div class="card card--white">
            <h4 class="h5 u-upper">Adresse</h4>
            <p>{{ site.address_line1 }},<br>{{ site.address_line2 }}</p>
            <h4 class="h5 u-upper">Telefonnummer</h4>
            <p><a class="u-underline" href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></p>
            <h4 class="h5 u-upper">E-Mail Adresse</h4>
            <p><a class="u-underline" href="mailto:{{ site.email }}">{{ site.email }}</a></p>
          </div>
          <div class="card card--yellow card--hours">
            <h4 class="h5 u-upper">Öffnungszeiten</h4>
            {% for h in site.hours %}
              <div class="hours-row"><span>{{ h.days }}</span><span>{{ h.time }}</span></div>
            {% endfor %}
          </div>
        </div>
        <a class="besuch__map" href="{{ home.besuch.map_link }}" target="_blank" rel="noopener">
          {% img home.besuch.map_image, "Karte: " + site.address_line1 + ", " + site.address_line2, "(max-width: 900px) 100vw, 660px" %}
        </a>
      </div>
      <div class="besuch__cta">
        <a href="{{ home.besuch.cta_anchor }}" class="btn btn--yellow">{{ home.besuch.cta_label }}</a>
      </div>
      <div class="besuch__areas">
        <h4 class="h5 u-upper">{{ home.besuch.areas_heading }}</h4>
        <div class="besuch__areas-list">
          {% for area in home.besuch.areas %}
            <span class="mono-label mono-label--light">{{ area }}</span>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
